# Database
POSTGRES_DSN=postgresql+psycopg://fainit_user:your_secure_password@localhost:5432/fainit
POSTGRES_DB=fainit
POSTGRES_USER=fainit_user
POSTGRES_PASSWORD=your_secure_password

# Authentication
SECRET_KEY=change-this-to-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Models (pretrained - inference only)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
TEXT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_DEVICE=auto

# Legacy storage migration only; report images live in PostgreSQL report_images
UPLOAD_DIR=./uploads

# Evaluation (run endpoint is admin-only; disable it in production-like environments)
EVALUATION_RUN_ENABLED=true
EVALUATION_DATASET_PATH=../datasets/evaluation/dataset.json
# Legacy migration only; evaluation runs live in PostgreSQL evaluation_runs
EVALUATION_RESULTS_DIR=../datasets/evaluation/results
